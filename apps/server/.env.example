# apps/server — configuration contract.
#
# Copy to .env and edit. `.env` is never committed (root CLAUDE.md).
#
# Every variable below is read once at boot by internal/infra/config. A required
# one that is absent OR empty is a startup error naming it, not a default; the
# test in that package asserts this file declares every key the loader reads, so
# adding a variable and forgetting this file turns the suite red.

# Address the HTTP server binds, as host:port. Required.
# Loopback for local work; 0.0.0.0 inside a container, where the port is
# published by the compose file rather than by the process. Port 8081 leaves
# 8080 to apps/amc-worker.
NALANDA_ADDR=127.0.0.1:8081

# Path to the SQLite file. Required.
# It must live on a persistent volume in production (ADR-0007): the database is
# a file, and a container filesystem is not a place to keep one.
NALANDA_DATABASE_URL=./nalanda.db

# One of: debug, info, warn, error. Optional — defaults to info.
# A value outside that set is a startup error rather than a level nobody
# notices is off.
NALANDA_LOG_LEVEL=info

# --- The professor login (ADR-0009, #150) ---------------------------------
#
# Without these the server starts and nobody can log in, which is why the first
# three are required rather than optional: a backoffice nobody can enter fails
# at the moment someone needs it, not at boot.

# The base URL this server is reached at. Required.
# Scheme, host and optional port — and NO PATH. The routes are mounted at the
# origin root, so a base like https://host/backoffice would build a redirect URI
# that answers 404 after Google sends the professor back; it is refused at boot.
# Two things are built from it and neither tolerates a guess: the OAuth redirect
# URI, which Google matches character for character against the one registered
# with the client, and the session cookie's Secure attribute (https here means
# Secure there). It is NOT inferred from the request, because that would let a
# caller choose both.
NALANDA_PUBLIC_URL=http://127.0.0.1:8081

# The Google OAuth client. Both required.
# Created in Google Cloud console → APIs & Services → Credentials → OAuth client
# ID → Web application, with NALANDA_PUBLIC_URL + /login/google/callback among
# its authorised redirect URIs. Walkthrough: GOOGLE-CHECK.md.
# The secret is a secret: .env is never committed, and the server refuses to
# print this value in a log line or an error (internal/infra/config).
NALANDA_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
NALANDA_GOOGLE_CLIENT_SECRET=your-client-secret

# How long a session lives from creation. Optional — defaults to 720h (30 days).
# A Go duration ("720h", "168h"); zero or negative is a startup error, since a
# session would expire as it was created. It is not a sliding window: after it,
# the professor logs in again.
NALANDA_SESSION_TTL=720h

# The address allowed to adopt a server that has NO professors yet. Optional.
# On a database with zero professors, the first Google login by this exact
# address creates the professor and links the identity. With any professor
# already in the database it does nothing at all, so leaving it set is not a
# standing door — but removing it once you are in is still the tidier habit.
NALANDA_BOOTSTRAP_PROFESSOR_EMAIL=

# Whether a trusted reverse proxy owns X-Forwarded-For. Optional, defaults false.
# False in development and in every deploy where the server terminates its own
# connections; true behind Tailscale Funnel on the Jetson (#162), where the
# tunnel completes on 127.0.0.1 and RemoteAddr is loopback for every visitor.
# With this true the sessions table's IP column comes from the FIRST hop of
# X-Forwarded-For (the outermost proxy's write, per RFC 7239 §5.2); with it
# false, from RemoteAddr and NOTHING else. Setting it true where nothing sits
# in front of this server is the failure `TestTheSessionIPIgnoresAForgeable`
# `Header` was written to guard against — an attacker writes their chosen
# string into the table. Only "true" or "false" (case-insensitive); a
# misspelling is a startup error rather than a silent fall to false.
NALANDA_TRUST_PROXY_HEADERS=false

# --- Entrance controls, WP-E (issue #166) --------------------------------
#
# Without these the CONTROL SCREENS refuse to work. The login and health
# paths still answer; the professor sees an empty backoffice.

# Where the published question bank lives (ADR-0032). Required.
# Fetched ONCE at boot and held in memory; a parse failure there is a
# panic and the server does not start (the same rule the templates
# follow). http:// and https:// are production; file:// is the local-file
# override for development.
#
# For local development, point at the artifact apps/web builds and
# preview serves:
#   file:///path/to/nalanda/apps/web/dist/questions.json
# Or, for a compose run, at the mounted example file:
#   file:///work/questions.json
NALANDA_QUESTIONS_JSON_URL=file:///work/questions.json

# The AMC worker's HTTP origin (ADR-0030). Required.
# No path, no trailing slash — the worker's own routes are appended. In
# compose it is the service name: http://amc-worker:8080. Against
# `make serve` from apps/amc-worker it is http://127.0.0.1:8080.
NALANDA_AMC_WORKER_URL=http://amc-worker:8080

# Where the server sees the shared volume (ADR-0034 §Consequences).
# The .tex the generator emits always uses /work absolute paths — that
# is the worker's mount, not this one — so this value only decides where
# the server writes its files. In compose it is /work (the shared
# amc-work volume, mounted into both services).
NALANDA_WORK_DIR=/work

# The largest scan PDF the upload handler will accept, in whole megabytes
# (WP-F, issue #167). Optional — defaults to 100. A 4-page control scanned
# at 300 dpi is roughly 3–5 MB, so 100 fits a large class with room to
# spare and refuses a runaway upload before it enters the worker.
NALANDA_MAX_SCAN_MB=100
