{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NalandaBackupsWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::${NALANDA_S3_BUCKET}/backups/*"
      ]
    },
    {
      "Sid": "NalandaBackupsList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${NALANDA_S3_BUCKET}"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "backups/*"
          ]
        }
      }
    }
  ]
}
