# Health monitor container for the Nalanda Jetson deploy (#162, ADR-0038).
#
# alpine + curl (for Telegram) + wget (base image). Nothing else — the whole
# container's job is one long-lived shell loop.
#
# Shape from DocumentBuddy's scripts/Dockerfile.monitor. Rewired to Nalanda's
# monitor.sh; separate file so an edit to one never silently touches the
# other.
FROM alpine:3.20

RUN apk add --no-cache curl

# notify.sh is sourced by monitor.sh (extracted at #162 review, ARQ-2, so the
# backup container's copy cannot drift from this one).
COPY notify.sh /usr/local/bin/notify.sh
COPY monitor.sh /usr/local/bin/monitor.sh
RUN chmod +x /usr/local/bin/monitor.sh /usr/local/bin/notify.sh

ENTRYPOINT ["/bin/sh", "/usr/local/bin/monitor.sh"]
